<%- layout("layouts/boilerplate") %>

<style>
  .bookings-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    color: #222;
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .page-title::before {
    content: "";
    width: 5px;
    height: 35px;
    background: #dc3434;
    border-radius: 10px;
    display: inline-block;
  }

  .booking-item {
    background: white;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    display: grid;
    grid-template-columns: 120px 1fr auto;
    gap: 1.5rem;
    align-items: center;
    transition: all 0.3s ease;
  }

  .booking-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(220, 52, 52, 0.15);
  }

  .booking-item img {
    width: 120px;
    height: 90px;
    object-fit: cover;
    border-radius: 10px;
  }

  .booking-info h5 {
    font-weight: 700;
    color: #222;
    margin-bottom: 0.3rem;
  }

  .booking-info p {
    color: #666;
    font-size: 0.9rem;
    margin: 0.2rem 0;
  }

  .booking-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 130px;
  }

  .status-badge {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    border-radius: 25px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .status-confirmed { background: #d4edda; color: #155724; }
  .status-cancelled { background: #f8d7da; color: #721c24; }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background: white;
    border-radius: 20px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
  }

  .empty-state i {
    font-size: 4rem;
    color: #ddd;
    margin-bottom: 1rem;
  }

  .price-tag {
    font-size: 1.2rem;
    font-weight: 700;
    color: #dc3434;
  }

  @media (max-width: 600px) {
    .booking-item {
      grid-template-columns: 1fr;
    }

    .booking-item img {
      width: 100%;
      height: 150px;
    }
  }
</style>

<div class="bookings-container">
  <h2 class="page-title">My Bookings</h2>

  <% if (bookings.length === 0) { %>
    <div class="empty-state">
      <i class="fas fa-calendar-times"></i>
      <h4>No bookings yet</h4>
      <p class="text-muted">Start exploring and book your dream stay!</p>
      <a href="/listings" class="btn btn-dark mt-2">Explore Listings</a>
    </div>
  <% } else { %>
    <% for (let booking of bookings) { %>
      <% if (booking.listing) { %>
        <div class="booking-item">
          <img src="<%= booking.listing.image?.url || '/images/default.jpg' %>" alt="<%= booking.listing.title %>">

          <div class="booking-info">
            <h5><%= booking.listing.title %></h5>
            <p><i class="fas fa-map-marker-alt" style="color: #dc3434;"></i> <%= booking.listing.location %></p>
            <p><i class="fas fa-calendar-check" style="color: #667eea;"></i>
              <%= booking.checkIn.toDateString() %> → <%= booking.checkOut.toDateString() %>
            </p>
            <p><i class="fas fa-moon" style="color: #764ba2;"></i>
              <%= booking.nights %> nights · <%= booking.guests %> guest<%= booking.guests > 1 ? 's' : '' %>
            </p>
            <p class="price-tag">₹<%= Number(booking.totalPrice).toLocaleString("en-IN") %> total</p>
            <span class="status-badge status-<%= booking.status %>">
              <%= booking.status.charAt(0).toUpperCase() + booking.status.slice(1) %>
            </span>
          </div>

          <div class="booking-actions">
            <a href="/bookings/<%= booking._id %>" class="btn btn-dark btn-sm">View Details</a>
            <% if (booking.status === "confirmed") { %>
              <form method="POST" action="/bookings/<%= booking._id %>/cancel">
                <button type="submit" class="btn btn-outline-danger btn-sm w-100"
                  onclick="return confirm('Cancel this booking?')">
                  Cancel
                </button>
              </form>
            <% } %>
          </div>
        </div>
      <% } %>
    <% } %>
  <% } %>
</div>
